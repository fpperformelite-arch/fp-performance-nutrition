# ── Supabase ────────────────────────────────────────────────────────────
# Project Settings → API en tu proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service role: SOLO se usa en server-side (webhook, cron). Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── WhatsApp Cloud API (Meta) ──────────────────────────────────────────
# Estos son los valores "de plataforma" (tu app de Meta). Los datos por
# negocio (phone_number_id, verify_token) viven en la tabla bora_configs,
# no aquí — así un solo despliegue sirve a todos los tenants.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
# Token de acceso permanente (System User) generado en Meta Business Suite.
# Ver docs/whatsapp-setup.md paso 5.
WHATSAPP_ACCESS_TOKEN=
# Token que TÚ inventas y pones también en el panel de Meta al configurar
# el webhook. Se usa para el "verify token" del handshake GET.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=cambia-esto-por-un-secreto-largo

# ── Google Calendar ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# ── Stripe (se activa después del piloto) ──────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
