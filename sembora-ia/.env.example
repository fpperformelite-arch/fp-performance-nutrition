# ── Base de datos (Neon / Postgres) ────────────────────────────────────
# Usa la connection string "pooled" de Neon (el host trae "-pooler" en el
# nombre) — importante en Vercel/serverless para no agotar conexiones
# directas a Postgres. La consigues en tu proyecto de Neon → Connection Details.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/sembora?sslmode=require

# ── App ──────────────────────────────────────────────────────────────
# URL pública donde queda desplegada la app (usada en redirects de Stripe
# y como referencia en la documentación). En local: http://localhost:3000
APP_URL=http://localhost:3000

# ── WhatsApp Cloud API (Meta) ──────────────────────────────────────────
# Estos son los valores "de plataforma" (tu app de Meta, compartidos por
# todos los negocios). Los datos por negocio (phone_number_id, WABA ID)
# viven en la tabla bora_configs, editables desde /settings.
# Token de acceso permanente (System User). Ver docs/whatsapp-setup.md.
WHATSAPP_ACCESS_TOKEN=
# Clave secreta de tu app de Meta — el webhook la usa para verificar que
# cada petición realmente venga de Meta (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
# Token que TÚ inventas (ej. `openssl rand -hex 32`) y pones también en el
# panel de Meta al configurar el webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Google Calendar (OAuth) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# ── Stripe ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs de tus planes en Stripe (Dashboard → Product catalog).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# ── Cron de recordatorios ────────────────────────────────────────────────
# Secreto compartido para que solo Vercel Cron (o tú) puedan disparar
# /api/cron/reminders. Invéntalo con `openssl rand -hex 32`.
CRON_SECRET=
